#!/usr/bin/env bash
# Motor POSIX compatible con la guía que pide ./minios.
set -euo pipefail

root="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
port="${SENTINEL_PORT:-/dev/ttyUSB0}"
baud="${SENTINEL_BAUD:-921600}"
dashboard_port="${SENTINEL_DASHBOARD_PORT:-8080}"
reset=1

usage() {
    cat <<'EOF'
Uso: ./sentinel [--port PUERTO] [--baud BAUD] [--dashboard-port PUERTO] [--no-reset]

Arranca Sentinel OS en una ESP32 ya flasheada, el bridge UART y el dashboard
local. ./minios es el alias compatible solicitado por la rúbrica.
EOF
}

while (($#)); do
    case "$1" in
        --port) port="$2"; shift 2 ;;
        --baud) baud="$2"; shift 2 ;;
        --dashboard-port) dashboard_port="$2"; shift 2 ;;
        --no-reset) reset=0; shift ;;
        -h|--help) usage; exit 0 ;;
        *) printf 'sentinel: opción desconocida: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
done

if [[ ! -f "$root/tools/bridge.py" ]]; then
    printf 'sentinel: no encuentro tools/bridge.py\n' >&2
    exit 1
fi

# WSL no puede abrir COM8 directamente, pero el bridge nativo de Windows ya
# fue validado a 921600 baudios. Permitir ./minios --port COM8 conserva el
# comando literal de la rubrica sin degradar el enlace por USB/IP.
if [[ "$port" =~ ^COM[0-9]+$ ]]; then
    if ! command -v powershell.exe >/dev/null 2>&1; then
        printf 'sentinel: %s es un puerto Windows; ejecuta sentinel.ps1 desde PowerShell.\n' "$port" >&2
        exit 1
    fi
    windows_root="$(wslpath -w "$root")"
    powershell_args=(-NoProfile -ExecutionPolicy Bypass -File "$windows_root\\sentinel.ps1"
                     -Port "$port" -Baud "$baud" -DashboardPort "$dashboard_port")
    if (( ! reset )); then
        powershell_args+=(-NoReset)
    fi
    exec powershell.exe "${powershell_args[@]}"
fi

if [[ ! -c "$port" ]]; then
    printf 'sentinel: no existe el puerto serie %s\n' "$port" >&2
    printf 'sentinel: en Windows usa .\\sentinel.ps1 -Port COM8; en WSL adjunta la ESP32 con usbipd o indica --port.\n' >&2
    exit 1
fi

printf '[sentinel] Sentinel OS — arrancando los 3 componentes...\n'
printf '[sentinel] 1/3 kernel .......... ESP32 %s @ %s (se reinicia al abrir)\n' "$port" "$baud"
printf '[sentinel] 2/3 bridge .......... consola UART interactiva\n'
printf '[sentinel] 3/3 dashboard ....... http://127.0.0.1:%s\n' "$dashboard_port"
printf '[sentinel] listo. Ctrl+C cierra bridge, dashboard y puerto de forma limpia.\n'

args=("$root/tools/bridge.py" --port "$port" --baud "$baud" --serve "$dashboard_port" \
      --shell --sink sqlite --db "$root/build/sentinel.db")
if ((reset)); then
    args+=(--reset)
fi
exec python3 "${args[@]}"
